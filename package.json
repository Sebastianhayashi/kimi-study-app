{
  "name": "lucubro",
  "version": "1.0.0",
  "description": "A local-first AI company workbench for a single CEO.",
  "main": "company-server.js",
  "scripts": {
    "start": "node company-server.js",
    "start:legacy": "node server.js",
    "check": "node scripts/check-source-syntax.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "quality": "npm run check && npm test",
    "verify:wrp": "npm run quality && CI=1 npm run test:e2e:ci",
    "build": "CI=1 npx playwright test tests/e2e/diagnostic-company.spec.js --workers=1 --retries=0",
    "stabilization:baseline": "node scripts/capture-stabilization-baseline.js --verify --output .stabilization/baseline.json",
    "fixtures:build": "node scripts/build-test-fixtures.js",
    "fixtures:seed": "node scripts/seed-e2e-data.js",
    "demo:seed": "npm run fixtures:build && LUCUBRO_DATA_DIR=tests/.runtime/courses npm run fixtures:seed -- --clean",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "capture:readme-media": "node scripts/capture-readme-media.js",
    "verify:readme-media": "node scripts/verify-readme-media.js",
    "verify:readme-parity": "node scripts/verify-readme-parity.js",
    "verify:readme": "npm run verify:readme-media && npm run verify:readme-parity",
    "baseline:report": "node scripts/report-route-assets.js"
  },
  "keywords": [
    "lucubro",
    "ai-agents",
    "agent-orchestration",
    "company-workbench",
    "local-first",
    "claude-code",
    "codex",
    "playwright"
  ],
  "author": "Sebastian Hayashi",
  "license": "ISC",
  "dependencies": {
    "epubjs": "0.3.93",
    "express": "^5.2.1",
    "jszip": "3.10.1",
    "lenis": "^1.3.25",
    "multer": "^2.2.0",
    "pdfjs-dist": "5.4.149"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@playwright/test": "^1.61.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sebastianhayashi/lucubro.git"
  },
  "bugs": {
    "url": "https://github.com/Sebastianhayashi/lucubro/issues"
  },
  "homepage": "https://github.com/Sebastianhayashi/lucubro#readme",
  "engines": {
    "node": ">=22"
  }
}
